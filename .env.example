# Which backend to use: openai | azure | local
# Only the section below matching this needs filling in.
LLM_PROVIDER=openai

# --- openai ---
OPENAI_API_KEY="sk-....."
OPENAI_MODEL = "ft:gpt......"

# --- azure ---
AZURE_OPENAI_API_KEY = ""
AZURE_OPENAI_ENDPOINT = "https://#######.azure.com/"
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_API_VERSION=2025-04-01-preview
AZURE_BASE_MODEL=gpt-4.1
AZURE_FINETUNED_MODEL=gpt-4.1-mini

# --- local: any OpenAI-compatible server (vLLM, LM Studio, Ollama, TGI) ---
# LOCAL_MODEL must match an id reported by <LOCAL_BASE_URL>/models.
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=
LOCAL_API_KEY=not-needed

TRAINING_FILE_NAME = ""
