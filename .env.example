# Which backend to use: openai | azure | local
# Only the section below matching this needs filling in.
LLM_PROVIDER=openai

# --- openai ---
OPENAI_API_KEY="sk-....."
OPENAI_MODEL = "ft:gpt......"

# --- azure ---
# Both model vars take a DEPLOYMENT name (what you typed when deploying in
# Foundry), not a model name -- Azure resolves the model from the deployment.
# AZURE_FINETUNED_MODEL wins when set, so leave it empty for a base deployment.
AZURE_OPENAI_API_KEY = ""
AZURE_OPENAI_ENDPOINT = "https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_BASE_MODEL=
AZURE_FINETUNED_MODEL=

# --- local: any OpenAI-compatible server (vLLM, LM Studio, Ollama, TGI) ---
# LOCAL_MODEL must match an id reported by <LOCAL_BASE_URL>/models.
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=
LOCAL_API_KEY=not-needed

TRAINING_FILE_NAME = ""
